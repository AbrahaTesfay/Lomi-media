# Leave blank for local Vite proxy (/api -> localhost:4000).
# On separate production hosting, set your real HTTPS backend URL.
VITE_API_BASE_URL=

# Optional. Verified WhatsApp Business phone, digits with country code, no + or spaces.
# Leave unset until verified; the website will not invent a phone number.
VITE_PUBLIC_WHATSAPP_NUMBER=
