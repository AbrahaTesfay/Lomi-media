# Copy to server/.env for local development.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./data/lomi-contacts.sqlite
# Keep false unless you deploy behind a proxy that you control.
TRUST_PROXY=false

# ADMIN SETUP: Set these before the first API start to create your account.
# ADMIN_PASSWORD must be at least 12 characters. Do not commit this file after copying to .env.
# Remove ADMIN_PASSWORD from .env after the account is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_24_CHARACTER_PASSWORD
