# Copy to server/.env for local development.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=./data/lomi-contacts.sqlite
# Keep false unless you deploy behind a proxy that you control.
TRUST_PROXY=false

# ADMIN SETUP: Set these before the first API start to create your account.
# ADMIN_PASSWORD must be at least 12 characters. Do not commit this file after copying to .env.
# Remove ADMIN_PASSWORD from .env after the account is created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_24_CHARACTER_PASSWORD

# Public frontend URL used for account confirmation and password recovery emails.
# Production must use your verified HTTPS domain.
APP_BASE_URL=http://127.0.0.1:5173

# REQUIRED for new public account registration and password-reset emails.
# Obtain real credentials from your email service provider and configure
# them only in private server/.env, never in this committed example.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-private-smtp-password
# SMTP_FROM=no-reply@your-verified-domain.example
